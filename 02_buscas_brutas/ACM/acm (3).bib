@inproceedings{10.1145/3318396.3318409,
author = {Adesola, Shakirat Abimbola and Li, Yongmin and Liu, Xiaohui},
title = {Boredom in Learning},
year = {2019},
isbn = {9781450362672},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3318396.3318409},
doi = {10.1145/3318396.3318409},
abstract = {The type of emotion students experience in classroom environment and during learning has impact of their academic performance. If educationists are able to understand this, it will lead to better education planning. Boredom is one of the negative emotion that students experience during learning and it can impact their concentration and understanding of the concepts taught in class. This research investigated the impact of interest shown by students in the course in classroom environment. The result of the study revealed low correlation between the negative emotions and the positive emotions. Also, hopelessness was found to be experienced more often than boredom revealing frustration in an attempt to understand a concept. Boredom was found to have significant impact on the interest exhibited by students and in understanding the concept taught in class. It also has effect on the level of attention and engagement during lecture.},
booktitle = {Proceedings of the 2019 8th International Conference on Educational and Information Technology},
pages = {86–91},
numpages = {6},
keywords = {Keywords-component: Boredom, Interest and cognitive strategy use},
location = {Cambridge, United Kingdom},
series = {ICEIT 2019}
}

