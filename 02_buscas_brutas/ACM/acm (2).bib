@inproceedings{10.1145/3700297.3700399,
author = {Dan, Yinghan and Zhang, Yarui and Chen, Tianyong},
title = {Perceived Teacher Support and Academic Burnout among Lower Secondary School Students: Academic Self-efficacy and Academic Emotions as Mediators},
year = {2024},
isbn = {9798400707100},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3700297.3700399},
doi = {10.1145/3700297.3700399},
abstract = {Academic burnout (AB) is correlated with severe detrimental outcomes in students' development. Despite earlier research examining various intrinsic and extrinsic elements that mitigate burnout and highlighting the essential role of teacher support (TS), limited investigations have focused on how TS specifically affects AB. This study explores the connections and mechanisms between TS, academic self-efficacy (ASE), academic emotions (AEs), and AB, through a survey conducted with 371 lower secondary school participants. The results reveal that all variables were significantly interconnected (p &lt; 0.01). Regression analysis indicated that TS positively predicted ASE and AEs. ASE positively influenced AEs and negatively predicted AB. AEs negatively predicted AB. Moreover, ASE, AEs, and the mediating chain formed by these variables fully mediate TS and AB. The study clarifies the the connections and mechanisms between TS and AB, offering practical suggestions to provide empirical evidence and theoretical guidance for effectively alleviating burnout among lower secondary school students.},
booktitle = {Proceedings of the 2024 International Symposium on Artificial Intelligence for Education},
pages = {589–593},
numpages = {5},
keywords = {Academic burnout, Academic emotions, Academic self-efficacy, Lower secondary school students, Teacher support},
location = {
},
series = {ISAIE '24}
}

