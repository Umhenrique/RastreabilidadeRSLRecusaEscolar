@ARTICLE{Melin2022,
	author = {Melin, Johanna and Jansson-Fröjmark, Markus and Olsson, Nora Choque},
	title = {Clinical practitioners’ experiences of psychological treatment for autistic children and adolescents with school attendance problems: a qualitative study},
	year = {2022},
	journal = {BMC Psychiatry},
	volume = {22},
	number = {1},
	pages = {},
	doi = {10.1186/s12888-022-03861-y},
	url = {https://www.scopus.com/pages/publications/85127290244?origin=resultslist},
	affiliations = {Child and Adolescent Psychiatry Research Center (CAP), Stockholm County Council, Stockholm, Sweden; Centre for Psychiatry Research, Department of Clinical Neuroscience (CNS), Karolinska Institutet, & Stockholm Health Care Services, Liljeholmstorget 7, Stockholm, 117 63, Sweden; Department of Psychology, Stockholm University, Stockholm, Sweden},
	abstract = {Background: School attendance problems (SAPs) are common among children and adolescents with autism spectrum disorder (ASD). Currently, there is a lack of guidelines for treatment or interventions aimed at this group. Method: Twelve clinical practitioners were interviewed via in-depth interviews using a semi-structured question guide. Interviews were audiotaped, transcribed verbatim, and initially independently coded by two coders. The interviews were analyzed according to thematic analysis. Results: The majority of the clinicians reported that it was common that children and adolescents with ASD at CAP had prolonged SAPs. A total of four themes and 22 sub-themes were identified in the analysis: the treatment situation; treatment goals at CAP; treatment interventions; and desired development. Insufficient adaptations in response to core impairment of ASD and lack of support in their daily life could be factors to the development of SAPs. Prolonged social isolation in combination with severe psychiatric comorbidities was reported as a treatment barrier. Also, insufficient collaboration between mental health care services, school and social services obstructed the return to school for this group of students. Favorable factors for positive treatment outcome were: early detection, accurate assessment and coordination between mental health care and schools and environmental adaptation at school as well as at home, parent support and sometimes change of school. Concerning useful therapeutic techniques, exposure from cognitive-behavioral treatment was reported. Conclusion: Children and adolescents with ASD with limited societal support tend to develop SAPs. Important factors that impact the outcome of treatment were the length of the absence from school and the severity of psychiatric comorbidities. Tailored and adapted interventions at school, parent support and mental health care are needed. Research about assessment and treatment for children and adolescents with ASD and SAPs is needed. © 2022, The Author(s).},
	author_keywords = {And school refusal; Anxiety; Autism; Intervention; Psychological; School absenteeism; School attendance problems; Treatment},
	keywords = {Adolescent; Autism Spectrum Disorder; Autistic Disorder; Child; Humans; Qualitative Research; Schools; Students; adult; aged; Article; autism; autism assessment; behavior therapy; behavioral activation; clinical outcome; clinical practitioner; cognitive behavioral therapy; comorbidity; diagnostic accuracy; disease severity; early diagnosis; evolutionary adaptation; exposure; female; frustration; health care personnel; human; intersectoral collaboration; male; medical procedures; mental health care; mental health service; middle aged; motivational work; parent support; personal experience; procedures; professional competence; psychoeducation; psychotherapy; qualitative research; school; school attendance; school mapping; semi structured interview; social isolation; social support; social work; thematic analysis; treatment outcome; adolescent; child; psychology; student},
	correspondence_address = {N.C. Olsson; Centre for Psychiatry Research, Department of Clinical Neuroscience (CNS), Karolinska Institutet, & Stockholm Health Care Services, Stockholm, Liljeholmstorget 7, 117 63, Sweden; email: nora.choque-olsson@ki.se},
	publisher = {BioMed Central Ltd},
