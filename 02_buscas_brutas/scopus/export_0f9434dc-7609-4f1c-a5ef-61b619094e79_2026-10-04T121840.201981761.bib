@ARTICLE{Min2026,
	author = {Min, Yunkyung},
	title = {Why Are More and More Korean Teenagers Dropping Out of School?: Focusing on Panel Interview Analysis},
	year = {2026},
	journal = {Journal of Education for Students Placed at Risk},
	pages = {},
	doi = {10.1080/10824669.2026.2666173},
	url = {https://www.scopus.com/pages/publications/105038092080?origin=resultslist},
	affiliations = {Korean Educational Development Institute, South Korea},
	abstract = {This study aims to provide an in-depth understanding of the increasing school dropout rates among South Korean adolescents, despite a rapidly declining school-age population. Utilizing data from a longitudinal qualitative study initiated in 2018, this research analyzes interview transcripts from a panel of 51 out-of-school youth. The findings reveal that the reasons for dropping out are multifaceted, occurring at the individual, family, peer, and school levels. These reasons are systematically categorized using the tripartite framework of “push,” “pull,” and “falling out” factors. Specifically, rigid curricula and conflicts with teachers act as powerful “push” factors; the need for early career specialization or economic contribution serves as “pull” factors; and prolonged lethargy or psychological distress leads to a gradual “falling out” process. Critically, this study demonstrates that dropping out is rarely a result of a single, isolated event. Instead, it is the culmination of a “system failure” where multiple risk factors across different life domains intersect and accumulate over time. Based on these insights, the study proposes targeted policy interventions, including the implementation of flexible, student-centered curricula, the development of data-driven early warning systems, and the establishment of multi-layered support networks involving schools and local communities. © 2026 Taylor & Francis Group, LLC.},
	correspondence_address = {Y. Min; Korean Educational Development Institute, Jincheon, South Korea; email: ykmin@kedi.re.kr},
	publisher = {Routledge},
