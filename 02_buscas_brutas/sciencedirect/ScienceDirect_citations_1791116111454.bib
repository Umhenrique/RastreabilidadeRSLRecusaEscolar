@article{GUNGOR2026109196,
title = {Why parents of children aged 4–6 use generative AI: a qualitative interview study},
journal = {Children and Youth Services Review},
volume = {189},
pages = {109196},
year = {2026},
issn = {0190-7409},
doi = {https://doi.org/10.1016/j.childyouth.2026.109196},
url = {https://www.sciencedirect.com/science/article/pii/S0190740926004494},
author = {Beyza Şanal Güngör and Ali Güngör},
keywords = {Digital parenting, Preschool children, Parental decision-making, Child privacy, Algorithmic trust, Family support},
abstract = {Generative artificial intelligence tools (e.g., ChatGPT) are increasingly used for everyday problem-solving, yet little is known about why parents use these systems in early childhood parenting and how they manage privacy, trust, and responsibility when child-related concerns are involved. This qualitative, exploratory descriptive study examined parents’ reasons for using generative AI in relation to children aged 4–6 and the boundaries they set around such use. Online semi-structured interviews were conducted with 40 parents (20 mothers, 20 fathers) living in Ankara, İstanbul, and Denizli, Türkiye. Participants were purposively selected to include mothers and fathers from three cities who had used at least one generative AI tool within the past 12 months for a parenting-related or everyday family-life purpose. Interviews explored motivations for use, parenting situations that prompted consultation, perceived benefits and limitations, and privacy practices. Data were analyzed using reflexive thematic analysis. Findings showed that parents used generative AI for in-the-moment parenting guidance, age-appropriate explanations of difficult topics, activity and routine generation, parental self-regulation and repair, and boundary management around privacy and responsibility. Parents generally treated generative AI as a practical, context-dependent aid rather than as a parenting authority. They valued its speed and flexibility, but also described safeguards such as cross-checking outputs, withholding identifying child information, and seeking professional support for high-stakes concerns. The findings suggest that parent-facing generative AI use has child-facing implications for communication, routines, emotional support, privacy, and help-seeking in early childhood.}
}
@article{CHANG2018723,
title = {Functional Bowel Disorders: A Roadmap to Guide the Next Generation of Research},
journal = {Gastroenterology},
volume = {154},
number = {3},
pages = {723-735},
year = {2018},
issn = {0016-5085},
doi = {https://doi.org/10.1053/j.gastro.2017.12.010},
url = {https://www.sciencedirect.com/science/article/pii/S0016508517367148},
author = {Lin Chang and Carlo {Di Lorenzo} and Gianrico Farrugia and Frank A. Hamilton and Gary M. Mawe and Pankaj J. Pasricha and John W. Wiley},
keywords = {IBS, Brain−Gut Axis, Intestinal Barrier Dysfunction, Microbiome},
abstract = {In June 2016, the National Institutes of Health hosted a workshop on functional bowel disorders (FBDs), particularly irritable bowel syndrome, with the objective of elucidating gaps in current knowledge and recommending strategies to address these gaps. The workshop aimed to provide a roadmap to help strategically guide research efforts during the next decade. Attendees were a diverse group of internationally recognized leaders in basic and clinical FBD research. This document summarizes the results of their deliberations, including the following general conclusions and recommendations. First, the high prevalence, economic burden, and impact on quality of life associated with FBDs necessitate an urgent need for improved understanding of FBDs. Second, preclinical discoveries are at a point that they can be realistically translated into novel diagnostic tests and treatments. Third, FBDs are broadly accepted as bidirectional disorders of the brain−gut axis, differentially affecting individuals throughout life. Research must integrate each component of the brain−gut axis and the influence of biological sex, early-life stressors, and genetic and epigenetic factors in individual patients. Fourth, research priorities to improve diagnostic and management paradigms include enhancement of the provider−patient relationship, longitudinal studies to identify risk and protective factors of FBDs, identification of biomarkers and endophenotypes in symptom severity and treatment response, and incorporation of emerging “-omics” discoveries. These paradigms can be applied by well-trained clinicians who are familiar with multimodal treatments. Fifth, essential components of a successful program will include the generation of a large, validated, broadly accessible database that is rigorously phenotyped; a parallel, linkable biorepository; dedicated resources to support peer-reviewed, hypothesis-driven research; access to dedicated bioinformatics expertise; and oversight by funding agencies to review priorities, progress, and potential synergies with relevant stakeholders.}
}
@incollection{WARBURTON2022195,
title = {Children, Impact of Media on},
