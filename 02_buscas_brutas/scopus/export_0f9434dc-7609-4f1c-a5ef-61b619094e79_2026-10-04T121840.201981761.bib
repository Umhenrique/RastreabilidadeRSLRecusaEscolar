	author = {Visudtibhan, Anannit and Boonsopa, Chompoonoot and Thampratankul, Lunliya and Nuntnarumit, Pracha and Okaschareon, Chusak and Khongkhatithum, Chaiyos and Chiemchanya, Surang and Visudhiphan, Pongsakdi},
