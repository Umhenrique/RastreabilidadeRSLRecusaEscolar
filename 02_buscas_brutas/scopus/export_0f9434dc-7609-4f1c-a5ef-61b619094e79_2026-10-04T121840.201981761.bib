	author = {García-Martínez, Rafael and Noriega-Morales, Salvador A. and Poblano-Ojinaga, Eduardo-Rafael},
	title = {The Effect of Career Choice on Quality in Higher Education Institutions; [Efeito da escolha profissional na qualidade das instituições de ensino superior]; [Efecto de la elección de carrera en la calidad en instituciones de educación superior]},
