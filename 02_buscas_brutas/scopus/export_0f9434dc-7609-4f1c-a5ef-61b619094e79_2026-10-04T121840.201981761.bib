@ARTICLE{Boaler2024185,
	author = {Boaler, Rhonda and Bond, Caroline and Knox, Louise},
	title = {The collaborative development of a local authority emotionally based school non-attendance (Ebsna) early identification tool},
	year = {2024},
	journal = {Educational Psychology in Practice},
	volume = {40},
	number = {2},
