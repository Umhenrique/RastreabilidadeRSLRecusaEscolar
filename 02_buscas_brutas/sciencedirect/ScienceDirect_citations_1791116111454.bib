@article{BARRETT2026103095,
title = {Behavioral eco-wellness: Definition, conceptual framework, and research agenda},
journal = {Journal of Environmental Psychology},
volume = {113},
pages = {103095},
year = {2026},
issn = {0272-4944},
doi = {https://doi.org/10.1016/j.jenvp.2026.103095},
url = {https://www.sciencedirect.com/science/article/pii/S0272494426001969},
author = {Bruce Barrett and Katherine J. Cornwall and Maggie L. Grabow and Simon B. Goldberg},
keywords = {Active transport, Carbon footprint, Dietary intake, Health behavior, Planetary health, Pro-environmental behavior, Sustainability, Whole health},
abstract = {Two of humanity's greatest challenges are: (A) global warming and climate change, and (B) the epidemics of obesity, diabetes, and related metabolic disorders. Both are driven in part by individual behaviors and household-level choices relating to diet, physical activity, transportation, consumption, and energy use. Many of these behaviors affect both health and environmental sustainability, and hence should be prioritized as we seek to reduce morbidity and mortality while ensuring livable ecological systems. While the term “health behaviors” refers to activities supporting physical and mental well-being, and “pro-environmental behaviors” denote actions supporting sustainability, it is clear that many behaviors contribute to both. Examples include walking or biking rather than driving or eating a plant-forward diet. In this paper, we develop the concept of “behavioral eco-wellness”, defined as the choices, habits, and behaviors that advance both personal health and environmental sustainability. This conceptual framework integrates health-related and pro-environmental behaviors into the category of eco-wellness behaviors, or EWBs. We explore five aims: (1) identify EWB domains and components; (2) consider relationships and interactions among EWB domains and components; (3) explore relevance to societal systems; (4) describe methods for developing and testing interventions to support EWBs; (5) prioritize activities and timeline for research and implementation. We argue that reframing health and sustainability not as separate domains, but instead as integrated and mutually reinforcing aspects of a larger eco-wellness conceptual entity will offer a more holistic and impactful approach to addressing the global crises of climate change and behavior-related metabolic disease.}
}
