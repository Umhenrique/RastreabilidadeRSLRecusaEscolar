@ARTICLE{Boonstra2026,
	author = {Boonstra, Anouk and van Mastrigt, Ghislaine A. P. G. and Evers, Silvia M. A. A. and Osstyn, Sander and de Winter, Remco F. P. and Boonstra, Nynke and van Amelsvoort, Therese A. M. J. and Leijdesdorff, Sophie M. J.},
	title = {Health-related quality of life and cost-of-illness in young people seeking peer support at @ease: A Dutch burden of disease study},
	year = {2026},
	journal = {PLOS One},
	volume = {21},
	number = {7},
