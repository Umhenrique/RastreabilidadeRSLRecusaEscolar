Unique-ID = {WOS:000597243200001},
}

@article{ WOS:001272323500035,
Author = {Rosholm, Michael and Bodilsen, Simon Tranberg and Michel, Bastien and
   Nielsen, Albeck Soren},
Title = {Predictive risk modeling for child maltreatment detection and enhanced
   decision-making: Evidence from Danish administrative data},
Journal = {PLOS ONE},
Year = {2024},
Volume = {19},
Number = {7},
Month = {JUL 10},
Abstract = {Child maltreatment is a widespread problem with significant costs for
   both victims and society. In this retrospective cohort study, we develop
   predictive risk models using Danish administrative data to predict
   removal decisions among referred children and assess the effectiveness
   of caseworkers in identifying children at risk of maltreatment. The
   study analyzes 195,639 referrals involving 102,309 children Danish Child
   Protection Services received from April 2016 to December 2017. We
   implement four machine learning models of increasing complexity,
   incorporating extensive background information on each child and their
   family. Our best-performing model exhibits robust predictive power, with
   an AUC-ROC score exceeding 87\%, indicating its ability to consistently
   rank referred children based on their likelihood of being removed.
   Additionally, we find strong positive correlations between the model's
   predictions and various adverse child outcomes, such as crime, physical
   and mental health issues, and school absenteeism. Furthermore, we
   demonstrate that predictive risk models can enhance caseworkers'
   decision-making processes by reducing classification errors and
   identifying at-risk children at an earlier stage, enabling timely
   interventions and potentially improving outcomes for vulnerable
   children.},
DOI = {10.1371/journal.pone.0305974},
Article-Number = {e0305974},
EISSN = {1932-6203},
ORCID-Numbers = {Tranberg Bodilsen, Simon/0000-0002-6735-8475
   Michel, Bastien/0000-0003-3188-4331
   Nielsen, Søren Albeck/0000-0002-3318-4112
   Rosholm, Michael/0000-0001-8360-2127},
Unique-ID = {WOS:001272323500035},
}

@article{ WOS:001830828800001,
Author = {Wheeler, Marc},
Title = {Unveiling the mask: early indicators of hidden vulnerability and
   participation breakdown in mainstream education},
Journal = {ADVANCES IN AUTISM},
Year = {2026},
Month = {2026 JUL 28},
Abstract = {Purpose This study examines whether early indicators of emerging special
   educational needs and disabilities (SEND) vulnerability are observable
   within routine school experience prior to crisis-level participation
   breakdown, and how such signals are interpreted within school systems.
   Drawing on retrospective case analysis, it explores the timing,
   character and organisational interpretation of early warning signs
   embedded within apparently successful participation. This study aims to
   deepen understanding of how hidden vulnerability develops over time and
   to inform earlier, more responsive approaches to identification and
   support in mainstream education. Design/methodology/approach This study
   uses a retrospective qualitative case-based design, drawing on
   anonymised assessment material generated through routine professional
   practice. Four cases of pupils aged 12-15, whose participation in
   mainstream education deteriorated to school refusal or withdrawal, were
   purposively selected. Data sources included semi-structured parental
   interviews and school documentation. These were analysed using
   cross-case reflexive thematic analysis to reconstruct participation
   trajectories and identify early indicators of vulnerability, as well as
   how these were interpreted within school systems prior to escalation.
   Findings Findings indicate that early indicators of vulnerability were
   typically observable within routine school experience but embedded
   within apparently successful participation. Outward competence, reliance
   on contextual scaffolding and discrepancies between home and school
   presentation appeared to contribute to these signals being normalised or
   interpreted as typical development. Crisis may therefore be understood
   as reflecting the point at which compensatory participation becomes
   unsustainable, often during transition to secondary education. The
   results suggest that delayed recognition may stem less from the absence
   of observable and more from organisational interpretations shaping how
   competence and need are understood. Research limitations/implications
   This study draws on a small number of retrospective cases derived from
   practice-generated assessment material, and findings should therefore be
   interpreted as exploratory rather than generalisable. Retrospective
   reconstruction may be influenced by recall and documentation
   constraints. However, the study highlights the need for prospective
   research examining how early indicators of vulnerability are documented
   and interpreted in real time, and suggests that identification
   frameworks should consider sustainability of participation,
   environmental fit and effort, rather than attainment or behaviour alone.
   Practical implications This study draws on a small number of
   retrospective cases derived from practice-generated assessment material,
   and findings should therefore be interpreted as exploratory rather than
   generalisable. Retrospective reconstruction may be influenced by recall
   and documentation constraints. However, the study highlights the need
   for prospective research examining how early indicators of vulnerability
   are documented and interpreted in real time, and suggests that
   identification frameworks should consider the sustainability of
   participation, environmental fit and effort, rather than relying solely
   on attainment or behaviour. Social implications This study suggests that
   delayed recognition of hidden vulnerability may contribute to escalating
   distress, school avoidance and reduced access to education for some
   pupils with emerging SEND.
   Earlier identification of participation strain may reduce the likelihood
   of crisis, exclusion or long-term disengagement, thereby supporting more
   equitable educational experiences. Improving how schools interpret early
   signals of need may also have wider social benefits, including enhanced
   wellbeing, more sustained participation in education and reduced
   longer-term demand on specialist services. Originality/value This study
   contributes to the literature by examining the period preceding
   crisis-level participation breakdown, focusing not only on pupil
   characteristics but also on how early signals are organisationally
   interpreted within school systems. By reconstructing trajectories from
   routine assessment material, it highlights how vulnerability can remain
   embedded within apparently successful participation, and how contextual
   scaffolding and compensatory functioning may contribute to delayed
   recognition. The study offers a novel perspective by linking
   masking-informed theory with institutional decision-making, providing
   practically relevant insight into how early indicators may be visible
   yet not acted upon in mainstream education.},
DOI = {10.1108/AIA-02-2026-0022},
EarlyAccessDate = {JUL 2026},
ISSN = {2056-3868},
ResearcherID-Numbers = {Wheeler, Marc/QJW-9996-2026},
Unique-ID = {WOS:001830828800001},
}

@article{ WOS:000661058200001,
Author = {Pokhilenko, Irina and Janssen, Luca M. M. and Evers, Silvia M. A. A. and
   Drost, Ruben M. W. A. and Schnitzler, Lena and Paulus, Aggie T. G.},
Title = {Do Costs in the Education Sector Matter? A Systematic Literature Review
   of the Economic Impact of Psychosocial Problems on the Education Sector},
Journal = {PHARMACOECONOMICS},
Year = {2021},
Volume = {39},
Number = {8},
Pages = {889-900},
Month = {AUG},
Abstract = {Background Psychosocial (e.g., anxiety or behavior) problems lead to
   costs not only in the healthcare sector but also in education and other
   sectors. As psychosocial problems develop during the critical period of
   establishing educational trajectories, education costs are particularly
   relevant in the context of psychosocial problems among children and
   adolescents. Objectives This study aimed to gain insights into the
   methods used for the inclusion of education costs in health economics
   studies and into the proportion of the education costs in relation to
   the total costs associated with a condition or an intervention. Methods
   We systematically searched the PubMed, Embase, SSCI, CINAHL, PsycINFO,
   ERIC, and Econlit databases in August 2019 for economic evaluations of
   mental health, psychosocial and educational interventions, and
   cost-of-illness studies of mental, behavioral, and neurodevelopmental
   disorders conducted from a societal perspective in populations of
   children and adolescents. An additional search was conducted in February
   2021 to update the review. Results In total, 49 articles were included
   in the analysis. The most common cost items were special education,
   school absenteeism, and various educational professionals (educational
   psychologist). A variety of methods were employed for the
   identification, measurement, and/or valuation of education costs. The
   proportion of education costs to the total costs of
   condition/intervention ranged from 0 to 67\%, with the mean being
   18.5\%. Discussion Since education costs can constitute a significant
   proportion of the total costs of an intervention or condition, including
   them in health economics studies might be important in informing optimal
   resource allocation decisions. Although various methods are available
   for including education costs in health economics studies, further
   research is needed to develop evidence-based methods for producing
   comparable estimates.},
