	correspondence_address = {W. Pickett; Department of Community Health, Queen's University, Kingston General Hospital, Kingston, Ont. K7L 2V7, 76 Smart St, Canada; email: PickettW@post.queensu.ca},
	publisher = {American Medical Association},
