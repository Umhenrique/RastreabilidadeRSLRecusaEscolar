@ARTICLE{Dario2022522,
	author = {Dario, Amabile Borges and Kamper, Steven James and Williams, Christopher and Straker, Leon and O’Sullivan, Peter and Schütze, Robert and Smith, Anne},
	title = {Psychological distress in early childhood and the risk of adolescent spinal pain with impact},
	year = {2022},
	journal = {European Journal of Pain (United Kingdom)},
	volume = {26},
