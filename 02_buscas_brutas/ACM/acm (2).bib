@inproceedings{10.1145/3796114.3796128,
author = {Cheng, Lijun and Ikezu, Wakaba and Fukai, Momo and Kinoshita, Riew},
title = {The Impact of Collaborative Learning on Plant-dyeing Activities in Japanese Elementary School STEAM Education},
year = {2026},
isbn = {9798400721397},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3796114.3796128},
doi = {10.1145/3796114.3796128},
abstract = {In this study, a plant-dyeing activity based on STEAM education was designed for students of the second grade of a Japanese elementary school. The flag-making, as an extended part of the plant-dyeing activity, was meant to promote sensory stimulation, peer communication, and cooperation among them. Using a mixed-methods approach, the research involved administering pre- and post-activity questionnaires along with classroom observations. The data were analyzed using a free Python toolkit. Quantitative data were examined using paired t-tests. Qualitative data were assessed from open-ended responses and observational notes using sentiment and social network analyses to identify emotional shifts and interaction patterns before and after the collaborative tasks. The results indicate that the activity enhanced students’ social interactions, collaborative behaviors, and sense of belonging in the classroom. Multiple social behaviors, such as altruistic behavior, offers of mutual help, and interactions, were observed. Furthermore, initially hesitant students displayed increased engagement through peer support. The activity enhanced inclusivity and support within the classroom and provided reference examples for future research.},
booktitle = {Proceedings of the 2026 Asia-Pacific Intelligent Educational Technologies Conference},
pages = {83–92},
numpages = {10},
keywords = {Collaborative learning, Elementary school, Flag-making activity, Living environments study, Plant-dyeing activity, STEAM education},
location = {
},
series = {APIET '26}
}

