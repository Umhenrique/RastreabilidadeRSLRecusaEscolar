@CONFERENCE{Shi2026123,
	author = {Shi, Hanjing and Difranzo, Dominic},
	title = {When Learning Signals Become Safety Signals: A Bounded-Confidentiality Framework for Educational AI Agents},
	year = {2026},
	journal = {Proceedings of Machine Learning Research},
	volume = {339},
	pages = {123 - 128},
	url = {https://www.scopus.com/pages/publications/105048703236?origin=resultslist},
	affiliations = {Lehigh University, United States},
	abstract = {Educational AI agents are usually introduced as tutors, homework helpers, or study companions. As children use them regularly, learning help can become a disclosure site: a student may begin with a math problem and then describe bullying, fear of adult reaction, or school avoidance. This position paper asks how child-facing educational agents should preserve student trust while deciding what stays private, what can be shared under student control, and what must be routed to accountable adults. Full parental visibility would turn help-seeking into surveillance; full secrecy would leave serious harm unsupported. We argue for bounded confidentiality as a communication-governance framework: ordinary tutoring remains private unless student choice or credible danger creates a reason to involve adults. The paper specifies a response ladder for minimal records, student-reviewed communication, care-oriented adult prompts, and escalation to locally accountable humans. © 2026 H. Shi & D. DiFranzo.},
	author_keywords = {AI agents; bounded confidentiality; child safety; educational AI; privacy; safeguarding},
	keywords = {Artificial intelligence; Computer aided instruction; Education computing; Students; Teaching; AI agent; Bounded confidentiality; Child safety; Educational agents; Educational AI; Help seeking; Position papers; Privacy; Safeguarding; Data privacy},
