@inproceedings{10.1145/3607720.3607748,
author = {Badrani, Morad and Marouan, Adil and Kannouf, Nabil and Chetouani, Abdelaziz},
title = {Pathways to Success: A Study of Classification Algorithms for Guiding Middle School Students in Morocco},
year = {2023},
isbn = {9798400700194},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3607720.3607748},
doi = {10.1145/3607720.3607748},
abstract = {Guiding students to choose their paths for high school studies is a complex task, influenced by factors such as their academic performance and their social environment. To address this challenge, this paper aims to classify Moroccan middle school students into two main streams – scientific and literary – based on their academic performance and preferences. Real data from multiple middle schools in Nador, Morocco, were collected and analyzed for this purpose between 2018 and 2021, with 7720 students participating by selecting their field of study for the following academic year. An additional 12,280 observations were generated to bring the total dataset size to 20,000. To determine the most suitable algorithm for classification, four machine learning algorithms (Naive-Bayes, random forest, decision tree, and KNN) were evaluated based on classification accuracy, precision, recall, and F1-score. The results of the analysis revealed that the random forest algorithm performed the best, making it the most appropriate algorithm for guiding students. Overall, this research provides valuable insights for developing a system that can assist Moroccan middle school students with their academic orientation.},
booktitle = {Proceedings of the 6th International Conference on Networking, Intelligent Systems \&amp; Security},
articleno = {26},
numpages = {5},
keywords = {Artificial Intelligence, Decision Tree, Knn, Machine learning, Naive-Bayes, Random forest, Student’s Orientation},
location = {Larache, Morocco},
series = {NISS '23}
}

@inproceedings{10.1145/2330601.2330629,
author = {Buckingham Shum, Simon and Crick, Ruth Deakin},
title = {Learning dispositions and transferable competencies: pedagogy, modelling and learning analytics},
year = {2012},
isbn = {9781450311113},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/2330601.2330629},
doi = {10.1145/2330601.2330629},
abstract = {Theoretical and empirical evidence in the learning sciences substantiates the view that deep engagement in learning is a function of a complex combination of learners' identities, dispositions, values, attitudes and skills. When these are fragile, learners struggle to achieve their potential in conventional assessments, and critically, are not prepared for the novelty and complexity of the challenges they will meet in the workplace, and the many other spheres of life which require personal qualities such as resilience, critical thinking and collaboration skills. To date, the learning analytics research and development communities have not addressed how these complex concepts can be modelled and analysed, and how more traditional social science data analysis can support and be enhanced by learning analytics. We report progress in the design and implementation of learning analytics based on a research validated multidimensional construct termed "learning power". We describe, for the first time, a learning analytics infrastructure for gathering data at scale, managing stakeholder permissions, the range of analytics that it supports from real time summaries to exploratory research, and a particular visual analytic which has been shown to have demonstrable impact on learners. We conclude by summarising the ongoing research and development programme and identifying the challenges of integrating traditional social science research, with learning analytics and modelling.},
booktitle = {Proceedings of the 2nd International Conference on Learning Analytics and Knowledge},
pages = {92–101},
numpages = {10},
keywords = {transferable skills, learning power, learning how to learn, learning dispositions, learning analytics, effective lifelong learning inventory, educational assessment, 21st century skills},
location = {Vancouver, British Columbia, Canada},
series = {LAK '12}
}

@inproceedings{10.1145/3802133.3802194,
author = {Gong, Ting and Pu, Duoyi and Wang, Shihao and Shen, Zhao and Lin, Boxian},
title = {Data-Driven Learner Profiling and Supply Optimization in Blended Ideological and Political Courses: An Algorithm-Driven K-means Clustering and Optimization Study},
year = {2026},
isbn = {9798400721564},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3802133.3802194},
doi = {10.1145/3802133.3802194},
abstract = {To address divergent student needs in blended ideological and political education, this study analyzes data from 2,600 students in a “Current Affairs and Policy” course. Using an optimized K-means clustering algorithm based on a “behavior-cognition-attitude” framework, the research identifies four distinct learner profiles within an ethically-grounded, supportive labeling system designed to avoid stigma (e.g., “Learners Requiring Proactive Outreach” instead of static negative labels). The profiles are: Active Participants Learners (36.92\%), Theoretical Learners (49.23\%), Passive Learners (12.69\%), and Learners Requiring Proactively-supported Learners (1.15\%). A key finding reveals that the largest group, “Theoretical Learners,” exhibits a structural contradiction of being “active online but passive offline.” The study explicitly addresses ethical concerns regarding monitoring and labeling by embedding principles of dynamic reversibility, transparent student participation, and rigorous data anonymization into its methodology. Based on these insights, the paper proposes tiered, support-driven strategies—including scenario redesign, process-based evaluation, and early warning systems—thereby demonstrating how data-driven clustering, when ethically implemented, can enable precision teaching and personalized resource allocation while safeguarding student autonomy and dignity.},
booktitle = {Proceedings of the 2026 3rd International Conference on Informatics Education and Computer Technology Applications},
pages = {372–377},
numpages = {6},
keywords = {Blended Learning, Data-Driven Learner Profiling, Educational Data Mining, Ideological and Political Education, K-means Clustering},
location = {
},
series = {IECA 2026}
}

@inproceedings{10.1145/3795154.3795402,
author = {Wang, Yijie},
title = {Practical AI Approaches for Community Infection Early Warning: From Public Data to Actionable Insights},
year = {2026},
isbn = {9798400719981},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3795154.3795402},
doi = {10.1145/3795154.3795402},
abstract = {Community-level infectious disease surveillance faces significant challenges in resource-constrained environments where traditional monitoring systems exhibit substantial limitations. This study presents a practical AI framework that leverages de-identified, aggregated, and authorized data sources, as well as public proxy sources, including clinical visit patterns, pharmacy purchase records, and community behavioral signals, to enable early outbreak detection. Our approach integrates lightweight machine learning techniques with a two-tier architecture: (1) Core framework: Moving Percentile Method (MPM) combined with Seasonal-Trend decomposition using LOESS (STL) for primary outbreak detection, designed for scenarios with limited computational resources and small sample sizes; (2) Optional enhancement modules: CUSUM algorithms for detecting gradual-onset outbreaks and multi-signal fusion using Bayesian approaches for improved specificity. Deep learning models (LSTM, GNN) are evaluated as performance benchmarks but not recommended for resource-constrained deployments. The framework demonstrates superior performance compared to conventional methods, achieving 87.3\% sensitivity and 94.2\% specificity for the Combined Signals configuration (MPM with multi-stream fusion, as shown in Table 3) in detecting community-level outbreaks 4-7 days earlier than traditional surveillance systems. Through comprehensive validation across diverse outbreak scenarios, including respiratory illness clusters and the detection of emerging pathogens, our methodology provides actionable insights while maintaining operational sustainability with low false-positive rates (FPR) under operational constraints. The integration of multi-source public data fusion with robust anomaly detection algorithms offers a scalable solution for enhancing pandemic preparedness in communities lacking sophisticated surveillance infrastructure.},
booktitle = {Proceedings of the 2025 6th International Conference on Computer Science and Management Technology},
pages = {1545–1552},
numpages = {8},
keywords = {anomaly detection, community health monitoring, infectious disease surveillance, lightweight machine learning},
location = {
},
series = {ICCSMT '25}
}

@inproceedings{10.1145/3833541.3833714,
author = {Huang, Ni and Wang, Yidi and Chu, Jia},
title = {Diagnostic and Intervention Methods for Undergraduate Adaptive Learning Effectiveness Via Smart Courses},
year = {2026},
isbn = {9798400722646},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3833541.3833714},
doi = {10.1145/3833541.3833714},
abstract = {With the accelerating pace of digital education reformation, smart courses have become the core carrier for universities’ personalized teaching. However, there are still challenges faced by undergraduate students in the process of adaptive learning, such as lagging effectiveness evaluation, inadequate utilization of learners’ multi-modal data and homogeneous intervention strategies, thus making it hard to meet the students’ individual cognitive and emotional needs. In order to address the above problems, this paper proposes a “data-driven dynamic diagnosis – precision intervention” closed-loop method. First, the method uses a three-dimensional (cognitive, behavioral, affective) evaluation index system based on learners’ multi-modal data. Second, the classic Attentive Knowledge Tracing (AKT) model is improved by integrating affective factors to identify learning bottlenecks with more precision. Finally, hierarchical intervention strategies are designed and triggered via a decision-tree algorithm. In order to evaluate the effectiveness of the method, we implement 16-week empirical research in the course “Advanced Business English”. The result shows that the Composite Learning Effectiveness Index (CLEI) has increased by 35.1\%.},
booktitle = {Proceedings of the 2026 3rd International Conference on Digital Society and Artificial Intelligence},
pages = {1033–1038},
numpages = {6},
keywords = {Adaptive learning, Educational data mining, Knowledge tracing, Precision intervention, Smart courses},
location = {
},
series = {DSAI '26}
}

@inproceedings{10.1145/3448139.3448190,
author = {Xu, Yang and Wilson, Kevin},
title = {Early Alert Systems During a Pandemic: A Simulation Study on the Impact of Concept Drift},
year = {2021},
isbn = {9781450389358},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3448139.3448190},
doi = {10.1145/3448139.3448190},
abstract = {Predictions from early alert systems are increasingly being used by institutions to assist decision-making and support at-risk individuals. Concept drifts caused by the 2020 SARS-CoV-2 pandemic are threatening the performance and usefulness of the machine learning models that power these systems. In this paper, we present an analytical framework that uses imputation-based simulations to perform preliminary evaluation on the extent to which data quality and availability issues impact the performance of machine learning models. Guided by this framework, we studied how these issues would impact the performance of the high school dropout prediction model implemented in the Early Warning System (EWS). Results show that despite the disruptions, this model can still be reasonably useful in assisting decision-making. We discuss the implications of these findings in more general educational contexts and recommend steps in countering the challenges of using predictions from imperfect machine learning models in early alert systems and, more broadly, learning analytic research that uses longitudinal data.},
booktitle = {LAK21: 11th International Learning Analytics and Knowledge Conference},
pages = {504–510},
numpages = {7},
keywords = {simulation, pandemic, imputation, early alert system, dropout prediction, concept drift},
location = {Irvine, CA, USA},
series = {LAK21}
}

@inproceedings{10.1145/3746467.3801527,
author = {Hackman, Sabrina and Johnson, Michelle and Taylor, W. Chris and Yellamraju, Anisha and Taeb, Maryam},
title = {Privacy Concerns of AI-Based Surveillance Systems Under FERPA and Educational Privacy Laws},
year = {2026},
isbn = {9798400720628},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3746467.3801527},
doi = {10.1145/3746467.3801527},
abstract = {K-12 schools are increasingly implementing Artificial Intelligenc (AI)-based surveillance tools, such as facial recognition and behavior-monitoring systems, to enhance campus safety. However, these tools collect sensitive biometric and behavioral data, raising concerns about privacy, consent, and potential discrimination. Prior studies show that AI surveillance systems often rely on opaque algorithms that shape disciplinary or safety decisions without transparency. Privacy laws, particularly the Family Educational Rights and Privacy Act (FERPA), were not designed for algorithmic monitoring or inferential data practices. Studies indicate that gaps in FERPA's definitions of educational records and personally identifiable information allow schools and third party vendors to process biometric and behavioral data with limited oversight. Our review finds significant regulatory gaps and underscores the need for updated equitable policies that ensure transparency, accountability, and the protection of student rights as AI monitoring expands across K-12 education. This review distinguishes between raw educational records and AI-generated inferences, highlighting how this distinction complicates Family Educational Rights and Privacy Act compliance and enforcement.},
booktitle = {Proceedings of the 2026 ACM Southeast Conference},
pages = {183–192},
numpages = {10},
keywords = {artificial intelligence, data privacy, AI-based surveillance systems, education privacy laws, FERPA},
location = {Troy University, Troy, AL, USA},
series = {ACMSE 2026}
}

@article{10.1145/3567556,
author = {Caddle, Xavier V. and Naher, Nurun and Miller, Zachary P. and Badillo-Urquiola, Karla and Wisniewski, Pamela J.},
title = {Duty to Respond: The Challenges Social Service Providers Face When Charged with Keeping Youth Safe Online},
year = {2022},
issue_date = {January 2023},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {7},
number = {GROUP},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3567556},
doi = {10.1145/3567556},
abstract = {Social service providers play a vital role in the developmental outcomes of underprivileged youth as they transition into adulthood. Educators, mental health professionals, juvenile justice officers, and child welfare caseworkers often have first-hand knowledge of the trials uniquely faced by these vulnerable youth and are charged with mitigating harmful risks, such as mental health challenges, child abuse, drug use, and sex trafficking. Yet, less is known about whether or how social service providers assess and mitigate theonline risk experiences of youth under their care. Therefore, as part of the National Science Foundation (NSF) I-Corps program, we conducted interviews with 37 social service providers (SSPs) who work with underprivileged youth to determine what (if any) online risks are most concerning to them given their role in youth protection, how they assess or become aware of these online risk experiences, and whether they see value in the possibility of using artificial intelligence (AI) as a potential solution for online risk detection. Overall, online sexual risks (e.g., sexual grooming and abuse) and cyberbullying were the most salient concern across all social service domains, especially when these experiences crossed the boundary between the digital and the physical worlds. Yet, SSPs had to rely heavily on youth self-reports to know whether and when online risks occurred, which required building a trusting relationship with youth; otherwise, SSPs became aware only after a formal investigation had been launched. Therefore, most SSPs found value in the potential for using AI as an early detection system and to monitor youth, but they were concerned that such a solution would not be feasible due to a lack of resources to adequately respond to online incidences, access to the necessary digital trace data (e.g., social media), context, and concerns about violating the trust relationships they built with youth. Thus, such automated risk detection systems should be designed and deployed with caution, as their implementation could cause youth to mistrust adults, thereby limiting the receipt of necessary guidance and support. We add to the bodies of research on adolescent online safety and the benefits and challenges of leveraging algorithmic systems in the public sector.},
journal = {Proc. ACM Hum.-Comput. Interact.},
month = dec,
articleno = {6},
numpages = {35},
keywords = {underprivileged youth, online safety, human-centered, artificial intelligence}
}

@inproceedings{10.1145/3491140.3528670,
author = {Su, Mengchen and Olson, Lukas A. and Jarratt, Daniel C. and Varma, Sashank and Konstan, Joseph A. and Keller, Rebecca J. L. and Chen, Bodong},
title = {Re-envisioning a K-12 Early Warning System with School Climate Factors},
year = {2022},
isbn = {9781450391580},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3491140.3528670},
doi = {10.1145/3491140.3528670},
abstract = {The Every Student Succeeds Act (ESSA) prescribes holistic measures of schools for student success and well-being. However, many early warning systems rely exclusively on the "Attendance, Behavior, Course" (ABC) taxonomy, which misses potentially crucial determinants such as school climate and students' socioemotional learning. We report early findings from a larger project that aims to apply machine learning methods to improve an early warning system by incorporating factors related to school climate and socioemotional learning. These preliminary analyses suggest that a culturally inclusive, socially supportive, and emotionally and physically safe school climate is related to academic success and fewer engagement/behavior problems at the school level. They suggest the promise of integrating these features into early warning systems to help schools change their practices to better support student well-being.},
booktitle = {Proceedings of the Ninth ACM Conference on Learning @ Scale},
pages = {405–408},
numpages = {4},
keywords = {early warning system (EWS), school climate, socioemotional learning (SEL), student information system},
location = {New York City, NY, USA},
series = {L@S '22}
}

@inproceedings{10.1145/3289402.3289527,
author = {Oumaima, Zine and Abdelouafi, Meziane},
title = {Text-To-Speech based dictation platform for students with learning difficulties},
year = {2018},
isbn = {9781450364621},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3289402.3289527},
doi = {10.1145/3289402.3289527},
abstract = {The present research explored the impact of the aural feedback generated by text-to-speech (TTS) on Arabic language learners. A web-based dictation platform was developed for this purpose. It enables the users to have their text read out loud as they write. This aural feedback will enable them to auto detect their mistakes, make the perceived corrections and re-listen again. A study was carried out in two different primary schools to benchmark the effects of the tool on pupils from third, fourth and fifth grades. Overall, the test revealed a significant improvement in the pupils writing skills; the participants were able to locate and correct a high percentage of their mistakes under speech synthesis vocalization. Besides, in order to assess the extent to which the tool remains efficient even when applied to different categories of persons, a longitudinal study is now being launched on the illiterates and students with visual disabilities. Thus far, the first results are surprisingly very promising. Details of the results will be published in another paper.},
booktitle = {Proceedings of the 12th International Conference on Intelligent Systems: Theories and Applications},
articleno = {27},
numpages = {5},
keywords = {dictation, Text To Speech, Speech synthesis, Natural Language Processing, Computer Assisted Language Learning, Arabic language},
location = {Rabat, Morocco},
series = {SITA'18}
}

@inproceedings{10.1145/3491102.3501831,
author = {Cheng, Hao-Fei and Stapleton, Logan and Kawakami, Anna and Sivaraman, Venkatesh and Cheng, Yanghuidi and Qing, Diana and Perer, Adam and Holstein, Kenneth and Wu, Zhiwei Steven and Zhu, Haiyi},
title = {How Child Welfare Workers Reduce Racial Disparities in Algorithmic Decisions},
year = {2022},
isbn = {9781450391573},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3491102.3501831},
doi = {10.1145/3491102.3501831},
abstract = {Machine learning tools have been deployed in various contexts to support human decision-making, in the hope that human-algorithm collaboration can improve decision quality. However, the question of whether such collaborations reduce or exacerbate biases in decision-making remains underexplored. In this work, we conducted a mixed-methods study, analyzing child welfare call screen workers’ decision-making over a span of four years, and interviewing them on how they incorporate algorithmic predictions into their decision-making process. Our data analysis shows that, compared to the algorithm alone, workers reduced the disparity in screen-in rate between Black and white children from 20\% to 9\%. Our qualitative data show that workers achieved this by making holistic risk assessments and adjusting for the algorithm’s limitations. Our analyses also show more nuanced results about how human-algorithm collaboration affects prediction accuracy, and how to measure these effects. These results shed light on potential mechanisms for improving human-algorithm collaboration in high-risk decision-making contexts.},
booktitle = {Proceedings of the 2022 CHI Conference on Human Factors in Computing Systems},
articleno = {162},
numpages = {22},
keywords = {algorithm-assisted decision-making, algorithmic biases, child welfare, human-centered AI, machine learning},
location = {New Orleans, LA, USA},
series = {CHI '22}
}

