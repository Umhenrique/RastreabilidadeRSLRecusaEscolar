	affiliations = {Hackensack Meridian School of Medicine, Hackensack University Medical Center, Hackensack, NJ, United States; Department of Pediatrics, University of Cincinnati College of Medicine, Behavioral Medicine and Clinical Psychology, Cincinnati Children’s Hospital Medical Center, Cincinnati, OH, United States},
	abstract = {Juvenile fibromyalgia (JFM) is one of the most common chronic non-inflammatory musculoskeletal (MSK) pain conditions seen in pediatric rheumatology settings. In Western countries, White, non-Hispanic adolescent females are most commonly affected. Patients present with persistent widespread MSK pain along with other symptoms which may include fatigue, sleep difficulties, anxiety, headaches, dysautonomia, and irritable bowel syndrome. JFM is often associated with school absenteeism and marked impairment in physical and social activities. The Yunus and Masi classification criteria proposed in 1985 have historically been used for diagnosing JFM. In the past decade, the American College of Rheumatology (ACR) proposed new criteria for adult fibromyalgia and these criteria appear to have utility in classifying JFM in adolescents but further validation in pediatric populations is needed. The pathophysiology of JFM remains poorly understood since most of the mechanistic studies on fibromyalgia have been conducted in adults. Symptoms of JFM tend to persist into adulthood for the majority of patients. Current treatment recommendations support a multidisciplinary approach including education about chronic pain, a graded exercise program, cognitive behavioral therapy, sleep hygiene, and medication as appropriate. Early identification of JFM and initiation of multidisciplinary care is recommended to optimize pain treatment and prevention of long-term impairment. © Springer Nature Switzerland AG 2021, corrected publication 2021.},
	author_keywords = {Chronic widespread pain; Juvenile fibromyalgia; Musculoskeletal pain; Pain amplification syndrome; Pediatric rheumatology},
	correspondence_address = {S. Kashikar-Zuck; Department of Pediatrics, University of Cincinnati College of Medicine, Behavioral Medicine and Clinical Psychology, Cincinnati Children’s Hospital Medical Center, Cincinnati, United States; email: Susmita.Kashikar-Zuck@cchmc.org},
	publisher = {Springer International Publishing},
