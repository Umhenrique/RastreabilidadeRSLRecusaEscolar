@inproceedings{10.1145/3357729.3357758,
author = {Rubinstein, Barbara},
title = {Reducing School Absenteeism - Promoting Health},
year = {2019},
isbn = {9781450372084},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3357729.3357758},
doi = {10.1145/3357729.3357758},
abstract = {Education is crucial to social and economic development and has a profound impact on population health. The health benefits of education accrue at the individual level, the community level and at the national level. School absenteeism is a major concern, which has long-term consequences on the individual level and societal level. We present initial findings from a project which addresses the challenge of school absenteeism through an improved use of data and proactive interventions. In doing so we aim to contribute towards reaching several of the global goals in Agenda 2030. The school system in Gothenburg, Sweden, has been assigned the task of raising school attendance levels as a means of achieving academic goals and improving students' health. The present project is carried out in Angered, one of ten urban districts in Gothenburg. Angered faces great challenges regarding segregation and social exclusion, why the question of school absenteeism is an especially important issue in this area. The district administration Angered joined forces with several partners from academia and commercial actors to address this important issue. The intention is to proactively promote school attendance, instead of only taking measures when the students are already absent. One of the solutions is a digital tool that uses data related to student attendance, and, using machine learning, predicts presence and absence of any individual student. We are also exploring opportunities to develop a process of collecting questionnaire data from students using a mobile-app, which can also improve the predictions of the machine learning system. The mobile-app will also provide data that increases the understanding of the needs of students, and make schools better equipped to tailor successful interventions. We also plan for a digital action toolbox, that includes suggestions for actions that schools can use to increase the school attendance. Furthermore, the analysis of the data can provide us with better understanding of health needs of young people and a better understanding of school environment.},
booktitle = {Proceedings of the 9th International Conference on Digital Public Health},
pages = {129},
numpages = {1},
location = {Marseille, France},
series = {DPH2019}
}

@article{10.1145/3705724,
author = {Ullah, Naeem and Khan, Javed Ali and De Falco, Ivanoe and Sannino, Giovanna},
title = {Explainable Artificial Intelligence: Importance, Use Domains, Stages, Output Shapes, and Challenges},
year = {2024},
issue_date = {April 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {57},
number = {4},
issn = {0360-0300},
url = {https://doi-org.ez13.periodicos.capes.gov.br/10.1145/3705724},
doi = {10.1145/3705724},
abstract = {There is an urgent need in many application areas for eXplainable ArtificiaI Intelligence (XAI) approaches to boost people’s confidence and trust in Artificial Intelligence methods. Current works concentrate on specific aspects of XAI and avoid a comprehensive perspective. This study undertakes a systematic survey of importance, approaches, methods, and application domains to address this gap and provide a comprehensive understanding of the XAI domain. Applying the Systematic Literature Review approach has resulted in finding and discussing 155 papers, allowing a wide discussion on the strengths, limitations, and challenges of XAI methods and future research directions.},
journal = {ACM Comput. Surv.},
month = dec,
articleno = {94},
numpages = {36},
keywords = {Explainable Artificial Intelligence, literature review}
}

