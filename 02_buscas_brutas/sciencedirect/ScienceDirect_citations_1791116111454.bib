author = {Rashida M. Umar and Sule Apikoglu},
keywords = {Anxiety disorders, Mental health care, Pharmacist role, Pharmacotherapy, Psychotherapy},
abstract = {Anxiety disorders, associated with excessive fear, and related behavioral disturbances, are common across all ages. They are associated with significant functional impairment, expenditure, and poor quality of life. However, effective treatment improves symptoms and quality of life. Psychotherapy alone or in combination with pharmacotherapy is the first-line treatment in most patients. SSRIs and SNRIs are first-line agents across all ages, with better efficacy and tolerability. Benzodiazepines and tricyclic antidepressants are reserved for specific or resistant cases due to safety concerns. Pharmacists have a central role in ensuring the safe and effective use of anxiolytic pharmacotherapy.}
}
